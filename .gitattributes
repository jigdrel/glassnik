# Normalize line endings for everyone on the team.
# Without this, every file looks 100% changed whenever someone with a
# different editor/OS line-ending setting saves it — that's the #1 cause
# of "huge diff for a one-line change" and painful merge conflicts.

* text=auto eol=lf

*.dart text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.gradle text eol=lf
*.xml  text eol=lf

# Binary files - never touch these
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.jar  binary
*.keystore binary
